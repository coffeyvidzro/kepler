# Dugble server/local development environment
# Copy this file to .env when running the server locally.

# Application
APP_ENV=development
HTTP_PORT=8080
API_DOMAIN=localhost
BACKOFFICE_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Backoffice
BACKOFFICE_HTTP_PORT=8081
BACKOFFICE_ADMIN_EMAILS=admin@example.com

# Datastore
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dugble?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Docker Compose database defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dugble

# Browser/API security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_DOMAIN=
ENCRYPTION_KEYS=dug-v1:replace-with-base64-encoded-32-byte-key
VERIFY_HMAC_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# Request protection
ARCJET_KEY=

# AWS SES email
AWS_FROM_EMAIL=hello@example.com
AWS_REGION=eu-north-1
# Required for deployments outside AWS. Store these in the hosting provider's
# encrypted secret manager. AWS-hosted deployments may leave them empty and use
# an IAM role through the SDK default credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Dugble internally routes transactional and marketing mail to its built-in SES
# configuration sets and system tenant; those names are not deployment settings.
# One API receives feedback from both supported SES regions. Replace the account
# ID and topic names with the exact ARNs provisioned in AWS.
AWS_SNS_TOPIC_ARNS=arn:aws:sns:eu-north-1:123456789012:dugble-ses-events,arn:aws:sns:us-east-1:123456789012:dugble-ses-events

# SMS providers
ARKESEL_BASE_URL=https://sms.arkesel.com
ARKESEL_API_KEY=
MNOTIFY_BASE_URL=https://api.mnotify.com
MNOTIFY_API_KEY=

# NATS / queueing
NATS_URL=nats://localhost:4222
NATS_USER=dugble
NATS_PASSWORD=dugble

# Observability
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG_ENABLED=true

SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1
SENTRY_DEBUG=false

# Hubtel payments
